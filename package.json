{
  "name": "lightleak",
  "version": "0.2.0",
  "description": "A first-person puzzle game about a camera whose photographs become real objects.",
  "private": true,
  "main": "desktop/main.js",
  "author": "Jonah Saunders",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --dev",
    "test": "electron . --test",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "web": "node tools/webbuild.js",
    "icon": "node tools/icon.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.jonahsaunders.lightleak",
    "productName": "Lightleak",
    "files": [
      "index.html",
      "server.js",
      "js/**",
      "vendor/**",
      "levels/**",
      "desktop/**",
      "LICENSES.md",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lightleak-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Lightleak-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.puzzle-games",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Lightleak-${version}-mac.${ext}"
    }
  }
}
